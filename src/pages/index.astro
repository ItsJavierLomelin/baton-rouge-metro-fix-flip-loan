---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CityContent from '../components/CityContent.astro';
import {brand,domain,cities} from '../data/cities';
const title='Fix and Flip Loans in Greater Baton Rouge, LA | Baton Rouge Metro Fix & Flip Loan';
const description='We connect Baton Rouge, Zachary, Denham Springs and Gonzales area investors with fix and flip funding sources. Funding within 48 hours. Tell us your goal.';
const businessId=`https://${domain}/#business`;
const faq=[{q:'Are you a direct lender?',a:'No. We are connectors. We introduce investors to funding sources, and the funding source determines eligibility and terms.'},{q:'Does submitting guarantee funding?',a:'No. A submission starts a review, not an approval or commitment.'}];
const areas=cities.map(c=>({'@type':'City',name:c.name,containedInPlace:{'@type':'State',name:'Louisiana'}}));
const jsonld=[{'@context':'https://schema.org','@type':'WebSite',name:brand,url:`https://${domain}/`},{'@context':'https://schema.org','@type':'FinancialService','@id':businessId,name:brand,url:`https://${domain}/`,areaServed:areas,description:'Fix and flip funding connections for real estate investors across Baton Rouge, Zachary, Denham Springs, Gonzales and the surrounding East Baton Rouge, Livingston, Ascension and Iberville parish area. Not a direct lender.'},{'@context':'https://schema.org','@type':'Service',serviceType:'Fix and flip funding connection service',provider:{'@id':businessId},areaServed:areas},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
---
<Base title={title} description={description} path="/" jsonld={jsonld}><Header/><main><CityContent cityName="Baton Rouge Metro" location="Homepage" intro="Greater Baton Rouge has Garden District cottages and Mid City bungalows, mid-century ranches near LSU and the south side, and fast-growing subdivisions in Ascension and Livingston parishes. Tell us about the home, the work you plan and how you expect to sell. We are connectors, and we introduce your project to funding sources for funding within 48 hours." angle="A Spanish Town cottage, a Zachary ranch and a Prairieville subdivision home call for different scopes and sell to different buyers. Start with the real condition of the house, the work you plan and recent sales on the same street." caution="Flooding is part of this market's history, and termites, humidity and clay soils all matter. Check the flood status and the foundation before you rely on a budget, and tell us what you have confirmed." showCityGrid={true}/></main><Footer/></Base>
